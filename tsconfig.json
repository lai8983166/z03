{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "tests/**/*.ts",
    "config.js",
    "TcpBridge.js",
    "js/Udp.js",
    "js/CommandBuilder.js",
    "js/BinaryTableHelper.js"
  ],
  "exclude": ["node_modules"]
}
